  "text": "---\nimport ControlIcon from '../components/ControlIcon';\nimport Layout from '../layouts/Layout.astro';\n---\n\n<Layout title=\"Page not found — useAnimations\" description=\"This page doesn't exist.\" noindex>\n  <section class=\"mx-auto max-w-xl px-5 py-32 text-center\">\n    <ControlIcon client:load icon=\"alertTriangle\" on=\"screen\" size={56} className=\"mx-auto block text-accent\" />\n    <h1 class=\"mt-8 text-4xl font-semibold tracking-tight\">Page not found</h1>\n    <p class=\"mt-4 text-muted\">The page you're looking for doesn't exist or has moved.</p>\n    <div class=\"mt-8 flex justify-center gap-3\">\n      <a href=\"/\" class=\"inline-flex items-center gap-2 rounded-full bg-fg px-5 py-2.5 text-sm font-medium text-bg\"\n        ><ControlIcon client:idle icon=\"home\" />Home</a\n      >\n      <a href=\"/icons\" class=\"inline-flex items-center gap-2 rounded-full border border-line-strong px-5 py-2.5 text-sm\"\n        ><ControlIcon client:idle icon=\"grid\" />Browse icons</a\n      >\n    </div>\n    <nav aria-label=\"Popular pages\" class=\"mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-muted\">\n      <a href=\"/icons\" class=\"underline underline-offset-4 hover:text-fg\">All animated icons</a>\n      <a href=\"/categories\" class=\"underline underline-offset-4 hover:text-fg\">Categories</a>\n      <a href=\"/interactions\" class=\"underline underline-offset-4 hover:text-fg\">Interactions</a>\n      <a href=\"/documentation\" class=\"underline underline-offset-4 hover:text-fg\">Documentation</a>\n    </nav>\n  </section>\n</Layout>\n",
  "version": 1
}
