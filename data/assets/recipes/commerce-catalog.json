  "code": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Useful things — catalog starter</title><style>\n:root{--paper:#f8f8f2;--ink:#22382e;--muted:#4d6256;--accent:#285b43;--line:#8eaa97;--wash:#e4ecdf}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:1rem/1.6 system-ui,sans-serif}a{color:inherit;text-underline-offset:.2em}button,select{font:inherit;color:inherit;background:var(--paper);border:1px solid var(--accent);border-radius:0;padding:.65rem;min-height:44px}button{cursor:pointer}button:hover{background:var(--wash)}:focus-visible{outline:3px solid #8a411b;outline-offset:4px}.skip{position:absolute;top:-6rem;left:1rem;background:white;padding:1rem}.skip:focus{top:1rem}.wrap{max-width:78rem;margin:auto;padding:clamp(1rem,4vw,3rem)}header{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;border-bottom:1px solid var(--ink);padding-bottom:1rem}.brand{font:700 1.5rem Georgia,serif}h1{font:400 clamp(2.5rem,5vw,4rem)/1.15 Georgia,serif;margin:2rem 0 .7rem}.intro{max-width:55ch}.toolbar{display:flex;gap:1rem;align-items:end;justify-content:space-between;flex-wrap:wrap;border-block:1px solid var(--line);padding:1rem 0;margin:2rem 0}.filters{display:flex;gap:1rem;flex-wrap:wrap}.filters label{display:grid;gap:.3rem;font-size:.85rem}.count{font-size:.9rem;margin:.5rem 0}.products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem}.product[hidden]{display:none}.object{aspect-ratio:4/3;background:var(--wash);display:grid;place-items:center;position:relative;overflow:hidden;border:1px solid var(--line)}.shape{width:45%;height:55%;background:#ab7551;border:3px solid #62452f;box-shadow:8px 10px 0 #becdb5}.cup{border-radius:12% 12% 40% 40%;height:42%;background:#c6b58a}.cup:after{content:'';display:block;width:30%;height:60%;border:6px solid #62452f;border-left:0;position:relative;left:100%;top:15%;border-radius:0 50% 50% 0}.tray{height:25%;width:65%;border-radius:50%;background:#c59667}.book{background:#456954;border-color:#264532;transform:rotate(-8deg);box-shadow:6px 5px 0 #f8f8f2,9px 8px 0 #264532}.product h2{font-size:1.15rem;margin:.8rem 0 .3rem}.product p{font-size:.9rem;color:var(--muted);margin:.3rem 0}.price{font-variant-numeric:tabular-nums;font-weight:600}.product details{margin-top:.75rem;border-top:1px solid var(--line);padding-top:.65rem}.product summary{cursor:pointer;min-height:44px;display:list-item;padding:.3rem}.empty{padding:2rem;border:1px solid var(--line)}.empty[hidden]{display:none}footer{border-top:1px solid var(--ink);margin-top:3rem;padding-top:1rem;font-size:.85rem;color:var(--muted)}@media(max-width:58rem){.products{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:36rem){.products{grid-template-columns:1fr}.filters{width:100%}.filters label{flex:1;min-width:10rem}.toolbar button{width:100%}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\n</style></head><body><a class=\"skip\" href=\"#main\">Skip to catalog</a><div class=\"wrap\"><header><span class=\"brand\">Useful things</span><a href=\"#notes\">About the demo</a></header><main id=\"main\" tabindex=\"-1\"><h1>Objects for an ordinary day.</h1><p class=\"intro\">A fictional catalog with original CSS object studies. Categories, descriptions, and prices demonstrate a listing layout, not available merchandise.</p><div class=\"toolbar\"><div class=\"filters\"><label for=\"category\">Category<select id=\"category\"><option value=\"all\">All objects</option><option value=\"desk\">Desk</option><option value=\"table\">Table</option></select></label><label for=\"sort\">Order<select id=\"sort\"><option value=\"featured\">Featured</option><option value=\"low\">Price: low to high</option><option value=\"high\">Price: high to low</option></select></label></div><button id=\"reset\" type=\"button\">Reset filters</button></div><p class=\"count\" id=\"count\" role=\"status\" aria-live=\"polite\">3 sample objects shown</p><section class=\"products\" id=\"products\" aria-label=\"Sample catalog\"><article class=\"product\" data-category=\"table\" data-price=\"24\" data-order=\"0\"><div class=\"object\" role=\"img\" aria-label=\"Original CSS study of a sand-colored cup\"><div class=\"shape cup\" aria-hidden=\"true\"></div></div><h2>Everyday cup</h2><p>Table · sand-colored concept</p><span class=\"price\">USD 24 · sample price</span><details><summary>Object notes</summary><p>A softly rounded silhouette for a warm catalog direction. Not a product specification or a safety claim.</p></details></article><article class=\"product\" data-category=\"table\" data-price=\"38\" data-order=\"1\"><div class=\"object\" role=\"img\" aria-label=\"Original CSS study of a low wooden tray\"><div class=\"shape tray\" aria-hidden=\"true\"></div></div><h2>Low tray</h2><p>Table · natural-tone concept</p><span class=\"price\">USD 38 · sample price</span><details><summary>Object notes</summary><p>A shallow oval study that provides a second scale and shape in the listing. Materials are illustrative only.</p></details></article><article class=\"product\" data-category=\"desk\" data-price=\"16\" data-order=\"2\"><div class=\"object\" role=\"img\" aria-label=\"Original CSS study of a green notebook\"><div class=\"shape book\" aria-hidden=\"true\"></div></div><h2>Open-page notebook</h2><p>Desk · forest-colored concept</p><span class=\"price\">USD 16 · sample price</span><details><summary>Object notes</summary><p>An angled rectangle contrasts with the table objects. Replace this study with licensed product photography and accurate details.</p></details></article></section><p class=\"empty\" id=\"empty\" hidden>No objects match this category. Reset the filters to see the sample catalog.</p></main><footer id=\"notes\">Local filter and sort demo only. No cart, checkout, stock, tax, shipping, payment, or backend. Without JavaScript, all objects remain readable.</footer></div><script>\nconst category=document.querySelector('#category'),sort=document.querySelector('#sort'),list=document.querySelector('#products');const items=Array.from(list.children);function update(){let visible=0;const ordered=[...items].sort((a,b)=>sort.value==='featured'?Number(a.dataset.order)-Number(b.dataset.order):(Number(a.dataset.price)-Number(b.dataset.price))*(sort.value==='high'?-1:1));for(const item of ordered){item.hidden=category.value!=='all'&&item.dataset.category!==category.value;if(!item.hidden)visible++;list.append(item)}document.querySelector('#count').textContent=visible+' sample '+(visible===1?'object':'objects')+' shown';document.querySelector('#empty').hidden=visible!==0}category.addEventListener('change',update);sort.addEventListener('change',update);document.querySelector('#reset').addEventListener('click',()=>{category.value='all';sort.value='featured';update()});\n</script></body></html>"
}
