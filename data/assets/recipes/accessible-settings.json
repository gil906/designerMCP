  "code": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Workspace preferences — accessible form starter</title><style>\n:root{--ink:#203344;--muted:#485d6e;--accent:#215278;--paper:#fff;--wash:#f2f5f8;--line:#8b9cab;--error:#a0202b}*{box-sizing:border-box}body{margin:0;background:var(--wash);color:var(--ink);font:1rem/1.6 system-ui,sans-serif}a{color:var(--accent);text-underline-offset:.2em}button,input,select{font:inherit}button{min-height:44px;padding:.65rem 1.1rem;border:1px solid var(--accent);color:var(--accent);background:white;cursor:pointer}.primary{background:var(--accent);color:white}:focus-visible{outline:3px solid #a15416;outline-offset:4px}.skip{position:absolute;top:-6rem;left:1rem;padding:1rem;background:white}.skip:focus{top:1rem}.wrap{max-width:68rem;padding:clamp(1rem,4vw,3rem);margin:auto}header{border-bottom:1px solid var(--line);padding-bottom:1rem}.layout{display:grid;grid-template-columns:1fr 2fr;gap:3rem;padding:2rem 0}.aside p{color:var(--muted);max-width:30ch}h1{font-size:2rem;letter-spacing:-.03em;line-height:1.2;margin:0 0 1rem}h2{font-size:1.1rem;margin:0}form{background:var(--paper);padding:clamp(1rem,3vw,2rem);border:1px solid var(--line);min-width:0}fieldset{border:0;padding:0;margin:0 0 2rem;min-width:0}legend{font-weight:650;margin-bottom:.8rem}.field{margin:1rem 0}label{display:block;font-weight:600}input[type=text],select{width:100%;min-height:44px;margin:.35rem 0;padding:.7rem;border:1px solid var(--line);border-radius:.2rem;color:var(--ink);background:white}input[aria-invalid=true]{border:2px solid var(--error)}.help{color:var(--muted);font-size:.9rem;margin:.3rem 0}.choice{display:flex;align-items:start;gap:.75rem;padding:.65rem 0;font-weight:400}.choice input{width:1.25rem;height:1.25rem;flex:none;margin:.2rem 0;accent-color:var(--accent)}.choice span{display:block}.choice strong{font-weight:600}.error{color:var(--error);font-size:.9rem}.error[hidden],.error-summary[hidden]{display:none}.error-summary{border:2px solid var(--error);padding:1rem;margin-bottom:1.5rem}.error-summary h2{color:var(--error)}.actions{display:flex;flex-wrap:wrap;gap:1rem;border-top:1px solid var(--line);padding-top:1.5rem}.status{min-height:3rem;color:var(--muted);font-size:.9rem}footer{font-size:.85rem;color:var(--muted)}@media(max-width:48rem){.layout{grid-template-columns:1fr;gap:1rem}.aside p{max-width:60ch}.actions button{flex:1}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\n</style></head><body><a class=\"skip\" href=\"#main\">Skip to preferences</a><div class=\"wrap\"><header><strong>Workspace / preferences</strong></header><main id=\"main\" tabindex=\"-1\" class=\"layout\"><div class=\"aside\"><h1>Make the workspace yours.</h1><p>Choose a display label and a default reading density. This demo keeps changes in memory only; reloading clears them.</p><p>No account, personal information, or notification delivery is connected.</p></div><form id=\"preferences\" aria-label=\"Workspace preferences\" novalidate><noscript><p>This starter requires JavaScript to validate and preview changes. Do not enter private information.</p></noscript><div class=\"error-summary\" id=\"errors\" tabindex=\"-1\" hidden><h2>Check one field before continuing</h2><a href=\"#workspace\">Enter a workspace label of 2–40 characters.</a></div><fieldset><legend>Display</legend><div class=\"field\"><label for=\"workspace\">Workspace label (required)</label><input id=\"workspace\" name=\"workspace\" type=\"text\" value=\"Sample workspace\" required minlength=\"2\" maxlength=\"40\" autocomplete=\"off\" aria-describedby=\"workspace-help workspace-error\"><p class=\"help\" id=\"workspace-help\">Use a project label, not a real person's name. Between 2 and 40 characters.</p><p class=\"error\" id=\"workspace-error\" hidden>Enter a label of 2–40 characters, excluding surrounding spaces.</p></div><div class=\"field\"><label for=\"density\">Reading density</label><select id=\"density\" name=\"density\" aria-describedby=\"density-help\"><option value=\"comfortable\">Comfortable</option><option value=\"compact\">Compact</option></select><p class=\"help\" id=\"density-help\">This selects a demo preference; it does not shrink text or touch targets.</p></div></fieldset><fieldset><legend>Updates</legend><label class=\"choice\"><input id=\"digest\" name=\"digest\" type=\"checkbox\" checked aria-describedby=\"digest-help\"><span><strong>Include a weekly summary</strong><span class=\"help\" id=\"digest-help\">Preview preference only. No message will be sent.</span></span></label><label class=\"choice\"><input id=\"tips\" name=\"tips\" type=\"checkbox\"><span><strong>Show occasional guidance</strong><span class=\"help\">Keep explanatory hints available in the sample workspace.</span></span></label></fieldset><div class=\"actions\"><button class=\"primary\" type=\"submit\">Save demo preferences</button><button id=\"reset\" type=\"button\">Restore defaults</button></div><p class=\"status\" id=\"status\" role=\"status\" aria-live=\"polite\">No changes saved in this session.</p></form></main><footer>Accessible client-side form starter. Add secure server validation, storage, authorization, and failure recovery before production.</footer></div><script>\nconst form=document.querySelector('#preferences'),nameInput=document.querySelector('#workspace'),errors=document.querySelector('#errors'),fieldError=document.querySelector('#workspace-error'),status=document.querySelector('#status');function clearErrors(){errors.hidden=true;fieldError.hidden=true;nameInput.removeAttribute('aria-invalid')}form.addEventListener('submit',event=>{event.preventDefault();const label=nameInput.value.trim();if(label.length<2||label.length>40){nameInput.setAttribute('aria-invalid','true');errors.hidden=false;fieldError.hidden=false;status.textContent='Preferences were not saved.';errors.focus();return}clearErrors();const density=document.querySelector('#density').value;status.textContent='Saved for this session: '+label+', '+density+' density. Weekly summary '+(document.querySelector('#digest').checked?'selected':'not selected')+'; guidance '+(document.querySelector('#tips').checked?'selected':'not selected')+'. Reloading clears this demo.'});document.querySelector('#reset').addEventListener('click',()=>{form.reset();clearErrors();status.textContent='Default preferences restored. No data was sent.'});\n</script></body></html>"
}
