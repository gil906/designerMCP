  "source_url": "original://designerMCP/recipes/analytics-dashboard",
  "code": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Operations notebook — dashboard starter</title><style>\n:root{--bg:#111c26;--panel:#182734;--ink:#e6edf2;--muted:#b7c6d1;--line:#536977;--accent:#8dd6c7;--warn:#f2cb85}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:.95rem/1.5 system-ui,sans-serif}a{color:var(--accent);text-underline-offset:.2em}:focus-visible{outline:3px solid var(--warn);outline-offset:4px}.skip{position:absolute;top:-6rem;left:1rem;background:var(--panel);padding:1rem}.skip:focus{top:1rem}.app{display:grid;grid-template-columns:13rem minmax(0,1fr);min-height:100vh}aside{padding:1.5rem;border-right:1px solid var(--line)}aside strong{display:block;margin-bottom:2rem}nav{display:grid;gap:1rem}main{padding:clamp(1rem,3vw,2rem);min-width:0}header{display:flex;flex-wrap:wrap;gap:1rem;justify-content:space-between;align-items:start}h1{font-size:1.8rem;letter-spacing:-.03em;margin:0}h2{font-size:1.1rem;margin:0 0 1rem}.muted{color:var(--muted)}.sample{font-size:.8rem;color:var(--warn)}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line);margin:1.5rem 0}.metric{padding:1.2rem;background:var(--panel)}dt{color:var(--muted);font-size:.85rem}dd{margin:.4rem 0 0;font-size:2rem;font-variant-numeric:tabular-nums}.columns{display:grid;grid-template-columns:1.5fr 1fr;gap:1.5rem}.panel{background:var(--panel);padding:1.25rem;border:1px solid var(--line)}.chart{display:grid;gap:.75rem}.bar-row{display:grid;grid-template-columns:4rem 1fr 3rem;align-items:center;gap:.7rem;font-variant-numeric:tabular-nums}.track{background:#314653;height:1rem}.bar{height:100%;background:var(--accent)}.bar-row span:last-child{text-align:right}.table-scroll{overflow:auto;max-width:100%;margin-top:1.5rem;border:1px solid var(--line)}table{border-collapse:collapse;min-width:38rem;width:100%;font-variant-numeric:tabular-nums}caption{text-align:left;padding:1rem;color:var(--muted)}th,td{text-align:left;padding:.75rem 1rem;border-top:1px solid var(--line)}thead{background:var(--panel)}th{font-weight:600}td:last-child{color:var(--warn)}.table-note{font-size:.85rem;color:var(--muted)}details{border-top:1px solid var(--line);padding:.8rem 0}summary{cursor:pointer;color:var(--accent)}.exceptions{padding-left:1.2rem}.exceptions li{padding:.4rem 0}footer{margin-top:2rem;font-size:.8rem;color:var(--muted)}@media(max-width:64rem){.columns{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:42rem){.app{grid-template-columns:1fr}aside{border-right:0;border-bottom:1px solid var(--line);padding:1rem}aside strong{margin-bottom:.6rem}nav{display:flex;gap:1rem;flex-wrap:wrap}.metric{padding:.8rem}dd{font-size:1.6rem}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\n</style></head><body><a class=\"skip\" href=\"#main\">Skip to dashboard</a><div class=\"app\"><aside><strong>Operations / notebook</strong><nav aria-label=\"Dashboard sections\"><a href=\"#main\" aria-current=\"page\">Overview</a><a href=\"#queue\">Queue details</a><a href=\"#definitions\">Definitions</a></nav></aside><main id=\"main\" tabindex=\"-1\"><header><div><h1>Queue overview</h1><p class=\"muted\">Example reporting window: Monday–Friday, one sample week.</p></div><p class=\"sample\">Fictional dataset · not live telemetry</p></header><dl class=\"metrics\"><div class=\"metric\"><dt>Items received</dt><dd>240</dd></div><div class=\"metric\"><dt>Items completed</dt><dd>192</dd></div><div class=\"metric\"><dt>Still open</dt><dd>48</dd></div><div class=\"metric\"><dt>Needs review</dt><dd>12</dd></div></dl><div class=\"columns\"><section class=\"panel\" aria-labelledby=\"volume-title\"><h2 id=\"volume-title\">Received items by day</h2><div class=\"chart\" role=\"img\" aria-label=\"Received items: Monday 36, Tuesday 52, Wednesday 44, Thursday 60, Friday 48. Total 240.\"><div class=\"bar-row\" aria-hidden=\"true\"><span>Mon</span><div class=\"track\"><div class=\"bar\" style=\"width:60%\"></div></div><span>36</span></div><div class=\"bar-row\" aria-hidden=\"true\"><span>Tue</span><div class=\"track\"><div class=\"bar\" style=\"width:86.67%\"></div></div><span>52</span></div><div class=\"bar-row\" aria-hidden=\"true\"><span>Wed</span><div class=\"track\"><div class=\"bar\" style=\"width:73.33%\"></div></div><span>44</span></div><div class=\"bar-row\" aria-hidden=\"true\"><span>Thu</span><div class=\"track\"><div class=\"bar\" style=\"width:100%\"></div></div><span>60</span></div><div class=\"bar-row\" aria-hidden=\"true\"><span>Fri</span><div class=\"track\"><div class=\"bar\" style=\"width:80%\"></div></div><span>48</span></div></div><p class=\"table-note\">Bars share a zero baseline; maximum shown is 60 items.</p></section><section class=\"panel\" aria-labelledby=\"exceptions-title\"><h2 id=\"exceptions-title\">Review notes</h2><ul class=\"exceptions\"><li>12 open items need a clearer next action.</li><li>Two sample queues have an unresolved dependency.</li><li>Counts describe volume, not quality or team performance.</li></ul></section></div><section id=\"queue\" aria-label=\"Queue details\"><div class=\"table-scroll\" role=\"region\" aria-label=\"Scrollable queue table\" tabindex=\"0\"><table><caption>Sample queues · review is a subset of open items</caption><thead><tr><th scope=\"col\">Queue</th><th scope=\"col\">Received</th><th scope=\"col\">Completed</th><th scope=\"col\">Open</th><th scope=\"col\">Needs review</th></tr></thead><tbody><tr><th scope=\"row\">Content preparation</th><td>100</td><td>84</td><td>16</td><td>4</td></tr><tr><th scope=\"row\">Documentation</th><td>80</td><td>60</td><td>20</td><td>6</td></tr><tr><th scope=\"row\">Release coordination</th><td>60</td><td>48</td><td>12</td><td>2</td></tr></tbody></table></div><p class=\"table-note\">On narrow screens, focus the table region and scroll horizontally.</p></section><section id=\"definitions\" aria-labelledby=\"definitions-title\"><h2 id=\"definitions-title\">Metric definitions</h2><details><summary>How are these counts related?</summary><p>All queues begin empty in this fictional example. Received minus completed equals open. Needs review is included in open, not added to it. Real dashboards must define time zones, missing data, and window boundaries.</p></details></section><footer>Read-only UI starter. No ingestion, export, authentication, or monitoring backend.</footer></main></div></body></html>"
}
