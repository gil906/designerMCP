  "code": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>EmberAI - Supercharge Your Invoicing With AI</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\" />\n    <style>\n      body {\n        font-family: \"Inter\", sans-serif;\n      }\n      .gradient-text {\n        background: linear-gradient(135deg, #f0abfc 0%, #818cf8 100%);\n        -webkit-background-clip: text;\n        background-clip: text;\n        color: transparent;\n      }\n      .glow-button {\n        background: linear-gradient(135deg, #8b5cf6 0%, #3b82f6 100%);\n        box-shadow: 0 0 28px rgba(139, 92, 246, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.3);\n      }\n      .glass {\n        background: rgba(255, 255, 255, 0.08);\n        border: 1px solid rgba(167, 139, 250, 0.45);\n        backdrop-filter: blur(12px);\n      }\n      .grid-bg {\n        background-image:\n          linear-gradient(rgba(196, 181, 253, 0.12) 1px, transparent 1px),\n          linear-gradient(90deg, rgba(196, 181, 253, 0.12) 1px, transparent 1px);\n        background-size: 64px 64px;\n        mask-image: radial-gradient(60% 55% at 50% 30%, #000 0%, transparent 100%);\n      }\n      @keyframes float {\n        0%, 100% { transform: translateY(0) }\n        50% { transform: translateY(-18px) }\n      }\n      .float {\n        animation: float 6s ease-in-out infinite;\n      }\n    </style>\n  </head>\n  <body class=\"min-h-screen overflow-x-hidden bg-gradient-to-b from-[#2a1470] via-[#1a0e4a] to-[#0d0828] text-white\">\n    <div class=\"pointer-events-none fixed inset-0 bg-[radial-gradient(40%_45%_at_50%_18%,rgba(168,85,247,0.55),transparent_70%),radial-gradient(30%_40%_at_12%_55%,rgba(236,72,153,0.35),transparent_70%),radial-gradient(30%_40%_at_88%_50%,rgba(59,130,246,0.4),transparent_70%)]\"></div>\n    <div class=\"grid-bg pointer-events-none fixed inset-0\"></div>\n\n    <header class=\"relative z-10 mx-auto mt-[22px] flex max-w-[1180px] items-center justify-between rounded-full glass px-[26px] py-[13px]\">\n      <a href=\"#\" class=\"flex items-center gap-[9px]\">\n        <span class=\"flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-violet-500 to-blue-500 shadow-[0_0_18px_rgba(139,92,246,0.7)]\">✨</span>\n        <span class=\"gradient-text text-[22px] font-extrabold\">EmberAI</span>\n      </a>\n      <nav class=\"flex items-center gap-[31px] text-[15px] font-semibold text-violet-100\">\n        <a href=\"#\">✨ Features</a>\n        <a href=\"#\">Pricing</a>\n        <a href=\"#\">💼 Solutions</a>\n        <a href=\"#\">Resources</a>\n        <a href=\"#\">Blog</a>\n        <a href=\"#\">🔥 Changelog</a>\n      </nav>\n      <div class=\"flex items-center gap-[17px]\">\n        <a href=\"#\" class=\"text-[15px] font-semibold\">Log in</a>\n        <a href=\"#\" class=\"glow-button rounded-full px-[22px] py-[11px] text-[15px] font-bold transition-all hover:scale-110\">Sign Up Free 🚀</a>\n      </div>\n    </header>\n\n    <main class=\"relative z-10 mx-auto flex max-w-[1180px] flex-col items-center px-6 pt-[46px] text-center\">\n      <a href=\"#\" class=\"glass animate-pulse rounded-full px-[18px] py-[7px] text-[14px] font-semibold text-violet-100 shadow-[0_0_24px_rgba(139,92,246,0.45)]\">✨ Introducing EmberAI 2.0 →</a>\n\n      <h1 class=\"mt-[46px] max-w-[940px] text-[80px] font-extrabold leading-[88px] tracking-[-0.02em]\">\n        <span class=\"gradient-text\">Supercharge Your Invoicing With AI</span> ✨\n      </h1>\n\n      <p class=\"mt-[58px] max-w-[660px] text-[21px] font-medium leading-[33px] text-violet-200\">\n        The all-in-one AI-powered platform that seamlessly automates your entire billing workflow. Get paid 10x faster! 💸\n      </p>\n\n      <div class=\"mt-[41px] flex items-center gap-[19px]\">\n        <a href=\"#\" class=\"glow-button rounded-full px-[34px] py-[19px] text-[21px] font-extrabold transition-all hover:scale-110\">Get Started Free 🚀</a>\n        <a href=\"#\" class=\"glass rounded-full px-[30px] py-[19px] text-[21px] font-bold transition-all hover:scale-110\">▶️ Watch Demo</a>\n      </div>\n\n      <div class=\"mt-[27px] flex items-center gap-3 text-[15px] font-medium text-violet-200\">\n        <div class=\"flex -space-x-2\">\n          <span class=\"h-8 w-8 rounded-full border-2 border-[#1a0e4a] bg-pink-400\"></span>\n          <span class=\"h-8 w-8 rounded-full border-2 border-[#1a0e4a] bg-violet-400\"></span>\n          <span class=\"h-8 w-8 rounded-full border-2 border-[#1a0e4a] bg-blue-400\"></span>\n          <span class=\"h-8 w-8 rounded-full border-2 border-[#1a0e4a] bg-emerald-400\"></span>\n          <span class=\"h-8 w-8 rounded-full border-2 border-[#1a0e4a] bg-amber-400\"></span>\n        </div>\n        <span>⭐⭐⭐⭐⭐ Loved by 10,000+ teams worldwide!</span>\n      </div>\n\n      <img src=\"assets/blob.webp\" alt=\"\" class=\"float mt-[38px] w-[640px] mix-blend-screen\" />\n    </main>\n  </body>\n</html>\n",
