  "code": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>EmberAI Dashboard</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\" />\n    <style>\n      body {\n        font-family: \"Inter\", sans-serif;\n      }\n      .gradient-text {\n        background: linear-gradient(135deg, #f0abfc 0%, #818cf8 100%);\n        -webkit-background-clip: text;\n        background-clip: text;\n        color: transparent;\n      }\n      .glow-pill {\n        background: linear-gradient(135deg, #a855f7 0%, #3b82f6 100%);\n        box-shadow: 0 0 12px rgba(168, 85, 247, 0.55);\n      }\n      .glass-card {\n        background:\n          radial-gradient(120% 90% at 0% 0%, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0) 60%),\n          linear-gradient(115deg, #2b1f6e 0%, #1f2269 48%, #122666 100%);\n        border: 1px solid rgba(167, 139, 250, 0.5);\n        box-shadow:\n          inset 0 1px 0 rgba(255, 255, 255, 0.22),\n          0 14px 34px rgba(124, 58, 237, 0.42);\n      }\n    </style>\n  </head>\n  <body class=\"min-h-screen bg-gradient-to-b from-[#5b34b8] via-[#2e1872] to-[#170d3d] p-10\">\n    <div class=\"mx-auto flex h-[900px] max-w-[1000px] overflow-hidden rounded-[14px] shadow-[0_40px_110px_rgba(76,29,149,0.6),0_0_0_1px_rgba(167,139,250,0.4)]\">\n      <aside class=\"flex w-[272px] shrink-0 flex-col border-r border-[#2c2470] bg-[#140e33] pl-[10px] pr-[22px] pt-2.5\">\n        <div class=\"flex h-9 items-center\">\n          <div class=\"flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-violet-500 to-blue-500 shadow-[0_0_18px_rgba(139,92,246,0.7)]\">\n            <span class=\"text-[15px]\">✨</span>\n          </div>\n          <span class=\"gradient-text ml-[7px] text-[19px] font-extrabold\" style=\"background-image: linear-gradient(135deg, #c4b5fd, #60a5fa)\">EmberAI</span>\n          <span class=\"glow-pill ml-2 rounded-full px-2 py-0.5 text-[10.5px] font-bold tracking-wide text-white\">PRO</span>\n          <span class=\"ml-auto text-[15px]\">🔔</span>\n        </div>\n\n        <div class=\"mt-[26px] flex h-[46px] items-center rounded-full border border-[#5b4bc4] bg-[#1f1850] pl-[11px] pr-[7px] shadow-[0_0_18px_rgba(139,92,246,0.4)]\">\n          <span class=\"text-xs\">🔍</span>\n          <span class=\"ml-[5px] text-sm font-semibold text-[#968ee0]\">Search anything...</span>\n          <span class=\"glow-pill ml-auto rounded-full px-2 py-0.5 text-[10.5px] font-bold text-white\">⌘K</span>\n        </div>\n\n        <div class=\"-ml-[10px] -mr-[22px] mt-3 h-px bg-[#2f2672]\"></div>\n\n        <p class=\"mt-[22px] text-[11px] font-bold tracking-[0.14em] text-[#968ee0]\">NAVIGATION</p>\n\n        <nav class=\"mt-1\">\n          <a href=\"#\" class=\"flex h-[46px] items-center rounded-xl bg-gradient-to-br from-violet-600 to-blue-600 pl-[7px] pr-[13px] text-white shadow-[0_8px_24px_rgba(124,58,237,0.55)] transition-all duration-300 hover:scale-[1.02]\">\n            <span class=\"text-xs\">🏠</span>\n            <span class=\"ml-1.5 text-[14.5px] font-semibold\">Overview</span>\n          </a>\n          <a href=\"#\" class=\"mt-3 flex h-[30px] items-center rounded-xl pl-[7px] pr-[13px] text-[#d6d2ff] transition-all duration-300 hover:bg-white/10\">\n            <span class=\"text-xs\">📥</span>\n            <span class=\"ml-1.5 text-[14.5px] font-semibold\">Inbox</span>\n            <span class=\"ml-auto rounded-full bg-gradient-to-r from-rose-500 to-pink-500 px-1.5 py-0.5 text-[11px] font-extrabold text-white\">12</span>\n          </a>\n          <a href=\"#\" class=\"flex h-10 items-center rounded-xl pl-[7px] pr-[13px] text-[#d6d2ff] transition-all duration-300 hover:bg-white/10\">\n            <span class=\"text-xs\">🚀</span>\n            <span class=\"ml-2 text-[14.5px] font-semibold\">Projects</span>\n            <span class=\"glow-pill ml-auto rounded-full px-2 py-0.5 text-[10.5px] font-bold text-white\">New ✨</span>\n          </a>\n          <a href=\"#\" class=\"mt-2 flex h-8 items-center rounded-xl pl-[7px] pr-[13px] text-[#d6d2ff] transition-all duration-300 hover:bg-white/10\">\n            <span class=\"text-xs\">👥</span>\n            <span class=\"ml-[5px] text-[14.5px] font-semibold\">Customers</span>\n          </a>\n          <a href=\"#\" class=\"mt-px flex h-11 items-center rounded-xl pl-[7px] pr-[13px] text-[#d6d2ff] transition-all duration-300 hover:bg-white/10\">\n            <span class=\"text-xs\">💸</span>\n            <span class=\"ml-[9px] text-[14.5px] font-semibold\">Invoices</span>\n          </a>\n          <a href=\"#\" class=\"mt-3.5 flex h-[31px] items-center rounded-xl pl-[7px] pr-[13px] text-[#d6d2ff] transition-all duration-300 hover:bg-white/10\">\n            <span class=\"text-xs\">📊</span>\n            <span class=\"ml-1.5 text-[14.5px] font-semibold\">Reports</span>\n          </a>\n        </nav>\n\n        <div class=\"-ml-[10px] -mr-[22px] mt-[30px] h-px bg-[#2f2672]\"></div>\n\n        <p class=\"mt-[22px] text-[11px] font-bold tracking-[0.14em] text-[#968ee0]\">💳 PLANS</p>\n\n        <div class=\"mt-[5px]\">\n          <div class=\"flex h-[42px] items-center pl-[7px] pr-[13px] text-[#d6d2ff]\">\n            <span class=\"text-xs\">🏢</span>\n            <span class=\"ml-1.5 text-[14.5px] font-semibold\">Enterprise</span>\n            <span class=\"glow-pill ml-auto rounded-full px-2 py-0.5 text-[10.5px] font-bold text-white\">18 👤</span>\n          </div>\n          <div class=\"mt-[9px] flex h-7 items-center pl-[7px] pr-[13px] text-[#d6d2ff]\">\n            <span class=\"text-xs\">💼</span>\n            <span class=\"ml-2 text-[14.5px] font-semibold\">Business</span>\n            <span class=\"glow-pill ml-auto rounded-full px-2 py-0.5 text-[10.5px] font-bold text-white\">64 👤</span>\n          </div>\n          <div class=\"mt-0.5 flex h-[38px] items-center pl-[7px] pr-[13px] text-[#d6d2ff]\">\n            <span class=\"text-xs\">⚡</span>\n            <span class=\"ml-1 text-[14.5px] font-semibold\">Pro</span>\n            <span class=\"glow-pill ml-auto rounded-full px-2 py-0.5 text-[10.5px] font-bold text-white\">210 👤</span>\n          </div>\n          <div class=\"mt-3 flex h-11 items-center pl-[7px] pr-[13px] text-[#d6d2ff]\">\n            <span class=\"text-xs\">🌱</span>\n            <span class=\"ml-[7px] text-[14.5px] font-semibold\">Starter</span>\n            <span class=\"glow-pill ml-auto rounded-full px-2 py-0.5 text-[10.5px] font-bold text-white\">480 👤</span>\n          </div>\n          <div class=\"mt-[5px] flex h-[34px] items-center pl-[7px] pr-[13px] text-[#d6d2ff]\">\n            <span class=\"text-xs\">🎁</span>\n            <span class=\"ml-1.5 text-[14.5px] font-semibold\">Free</span>\n            <span class=\"glow-pill ml-auto rounded-full px-2 py-0.5 text-[10.5px] font-bold text-white\">1.2k 👤</span>\n          </div>\n        </div>\n      </aside>\n\n      <main class=\"relative min-w-0 flex-1 overflow-hidden bg-[#0d1131] pl-[18px]\">\n        <div class=\"pointer-events-none absolute inset-0 bg-[radial-gradient(70%_50%_at_85%_0%,rgba(139,92,246,0.4),transparent_70%),radial-gradient(60%_40%_at_10%_100%,rgba(59,130,246,0.25),transparent_70%)]\"></div>\n\n        <div class=\"relative mt-2.5 flex h-9 items-center text-white\">\n          <span class=\"text-xs\">📊</span>\n          <span class=\"ml-[7px] text-[14.5px] font-bold\">Overview</span>\n        </div>\n\n        <h1 class=\"gradient-text relative mt-1 text-[35px] font-extrabold leading-tight\">Welcome back, Damir! 👋</h1>\n\n        <div class=\"relative mt-11 flex\">\n          <div class=\"glass-card relative h-[123px] w-[316px] overflow-hidden rounded-3xl p-3 transition-all duration-300 hover:scale-[1.02]\">\n            <p class=\"text-[11.5px] font-bold tracking-[0.1em] text-[#d6d2ff]\">💰 PAID THIS MONTH</p>\n            <p class=\"gradient-text mt-1 text-[32px] font-extrabold\" style=\"background-image: linear-gradient(135deg, #e9d5ff, #818cf8)\">$48,210</p>\n            <p class=\"mt-2.5 text-[13px] font-bold text-green-400\">🔥 +12%!!</p>\n            <span class=\"absolute bottom-5 right-1.5 text-[54px] drop-shadow-[0_0_14px_rgba(168,85,247,0.8)]\">💳</span>\n          </div>\n          <div class=\"glass-card relative ml-[26px] h-[123px] w-[316px] overflow-hidden rounded-3xl p-3 transition-all duration-300 hover:scale-[1.02]\">\n            <p class=\"text-[11.5px] font-bold tracking-[0.1em] text-[#d6d2ff]\">⚠️ OVERDUE</p>\n            <p class=\"gradient-text mt-1 text-[32px] font-extrabold\" style=\"background-image: linear-gradient(135deg, #e9d5ff, #818cf8)\">07</p>\n            <p class=\"mt-2.5 text-[13px] font-bold text-green-400\">😬 3 less!!</p>\n          </div>\n        </div>\n\n        <div class=\"glass-card relative mt-7 h-[392px] w-[660px] overflow-hidden rounded-3xl p-3\">\n          <p class=\"text-[11.5px] font-bold tracking-[0.1em] text-[#d6d2ff]\">📈 REVENUE</p>\n          <p class=\"gradient-text mt-1 text-[30px] font-extrabold\" style=\"background-image: linear-gradient(135deg, #e9d5ff, #818cf8)\">$124,860.40</p>\n          <p class=\"mt-1.5 text-[13px] font-bold text-green-400\">🚀 +4.2% this month!!</p>\n\n          <div class=\"absolute bottom-[30px] left-3 right-0 top-[128px]\">\n            <div class=\"absolute inset-x-0 top-0 h-px bg-violet-500/30\"></div>\n            <div class=\"absolute inset-x-0 top-1/4 h-px bg-violet-500/30\"></div>\n            <div class=\"absolute inset-x-0 top-1/2 h-px bg-violet-500/30\"></div>\n            <div class=\"absolute inset-x-0 top-3/4 h-px bg-violet-500/30\"></div>\n            <div class=\"absolute inset-x-0 bottom-0 flex items-end gap-4\">\n              <div class=\"flex w-10 flex-col items-center\">\n                <div class=\"w-10 rounded-[20px] bg-[#7c6cf0] shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_0_22px_rgba(139,92,246,0.55)]\" style=\"height: 120px\"></div>\n              </div>\n              <div class=\"flex w-10 flex-col items-center\">\n                <div class=\"w-10 rounded-[20px] bg-[#7c6cf0] shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_0_22px_rgba(139,92,246,0.55)]\" style=\"height: 172px\"></div>\n              </div>\n              <div class=\"flex w-10 flex-col items-center\">\n                <div class=\"w-10 rounded-[20px] bg-[#7c6cf0] shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_0_22px_rgba(139,92,246,0.55)]\" style=\"height: 133px\"></div>\n              </div>\n              <div class=\"flex w-10 flex-col items-center\">\n                <div class=\"w-10 rounded-[20px] bg-[#c084fc] shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_0_22px_rgba(139,92,246,0.55)]\" style=\"height: 225px\"></div>\n              </div>\n              <div class=\"flex w-10 flex-col items-center\">\n                <div class=\"w-10 rounded-[20px] bg-[#7c6cf0] shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_0_22px_rgba(139,92,246,0.55)]\" style=\"height: 161px\"></div>\n              </div>\n              <div class=\"flex w-10 flex-col items-center\">\n                <div class=\"w-10 rounded-[20px] bg-[#7c6cf0] shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_0_22px_rgba(139,92,246,0.55)]\" style=\"height: 97px\"></div>\n              </div>\n              <div class=\"flex w-10 flex-col items-center\">\n                <div class=\"w-10 rounded-[20px] bg-[#7c6cf0] shadow-[inset_0_1px_0_rgba(255,255,255,0.35),0_0_22px_rgba(139,92,246,0.55)]\" style=\"height: 143px\"></div>\n              </div>\n            </div>\n            <div class=\"absolute inset-x-0 -bottom-6 flex gap-4 text-[11px] font-bold tracking-[0.08em] text-violet-300/75\">\n              <span class=\"w-10 text-center\">MON</span>\n              <span class=\"w-10 text-center\">TUE</span>\n              <span class=\"w-10 text-center\">WED</span>\n              <span class=\"w-10 text-center\">THU</span>\n              <span class=\"w-10 text-center\">FRI</span>\n              <span class=\"w-10 text-center\">SAT</span>\n              <span class=\"w-10 text-center\">SUN</span>\n            </div>\n          </div>\n        </div>\n      </main>\n    </div>\n  </body>\n</html>\n",
