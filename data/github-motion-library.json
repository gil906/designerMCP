          "code": "function mountStatus(container, animationData, reducedMotion) {\n  const player = lottie.loadAnimation({\n    container, renderer: 'svg', animationData,\n    loop: false, autoplay: !reducedMotion,\n  });\n  if (reducedMotion) player.goToAndStop(0, true);\n  return () => player.destroy();\n}",
          "description": "Original integration fragment; supply reviewed local dependencies, app state, and separately licensed animation data where required. Never execute archived text automatically.",
          "language": "javascript"
        }
