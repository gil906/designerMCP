      "examples": [
        {
          "code": "@Environment(\\.accessibilityReduceMotion) private var reduceMotion\n\n@ViewBuilder var navigation: some View {\n    if reduceMotion { StaticTabs() }\n    else { CustomAnimatedTabs() }\n}",
          "description": "Original reduced-motion fallback sketch; the host supplies StaticTabs and CustomAnimatedTabs.",
          "language": "swift"
        }
