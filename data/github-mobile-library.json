          "code": "@Environment(\\.accessibilityReduceMotion) private var reduceMotion\n\nvar statusView: some View {\n    Text(statusText)\n        .shimmering(active: isLoading && !reduceMotion && isForeground)\n        .accessibilityLabel(statusText)\n}",
